from PIL import Image, ImageDraw, ImageFilter
import math
import os

S = 2048  # supersample large, then downscale hard for crisp anti-aliasing


def rotated_rect(cx, cy, length, width, angle_deg):
    angle = math.radians(angle_deg)
    dx, dy = length / 2, width / 2
    corners = [(-dx, -dy), (dx, -dy), (dx, dy), (-dx, dy)]
    pts = []
    for x, y in corners:
        rx = x * math.cos(angle) - y * math.sin(angle)
        ry = x * math.sin(angle) + y * math.cos(angle)
        pts.append((cx + rx, cy + ry))
    return pts


def soft_shadow_layer(size, shape_fn, blur_radius, offset=(0, 0), alpha=90):
    """Render shape_fn (drawing only a solid black silhouette) onto a blank layer,
    offset it, and blur it to create a soft drop shadow layer."""
    layer = Image.new("RGBA", size, (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    shape_fn(d, (0, 0, 0, alpha))
    layer = layer.filter(ImageFilter.GaussianBlur(blur_radius))
    shifted = Image.new("RGBA", size, (0, 0, 0, 0))
    shifted.paste(layer, offset, layer)
    return shifted


def vertical_gradient_ellipse(size, box, top_color, bottom_color):
    """An ellipse filled with a smooth vertical gradient."""
    x0, y0, x1, y1 = box
    h = int(y1 - y0)
    grad = Image.new("RGBA", size, (0, 0, 0, 0))
    gd = ImageDraw.Draw(grad)
    for i in range(h):
        t = i / max(h - 1, 1)
        r = int(top_color[0] + (bottom_color[0] - top_color[0]) * t)
        g = int(top_color[1] + (bottom_color[1] - top_color[1]) * t)
        b = int(top_color[2] + (bottom_color[2] - top_color[2]) * t)
        y = y0 + i
        gd.line([(x0, y), (x1, y)], fill=(r, g, b, 255))
    mask = Image.new("L", size, 0)
    md = ImageDraw.Draw(mask)
    md.ellipse(box, fill=255)
    out = Image.new("RGBA", size, (0, 0, 0, 0))
    out.paste(grad, (0, 0), mask)
    return out


def glossy_dab(size, cx, cy, r, base_color):
    """A paint dab with a subtle radial-style highlight for a glossy, dimensional look."""
    layer = Image.new("RGBA", size, (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    # Base circle, slightly darker at the bottom edge for depth
    dark = tuple(max(0, c - 35) for c in base_color)
    d.ellipse([cx - r, cy - r, cx + r, cy + r], fill=dark + (255,))
    inner_r = r * 0.92
    d.ellipse([cx - inner_r, cy - inner_r, cx + inner_r, cy + inner_r], fill=base_color + (255,))
    # Soft white gloss highlight, upper-left
    gloss = Image.new("RGBA", size, (0, 0, 0, 0))
    gd = ImageDraw.Draw(gloss)
    gx, gy = cx - r * 0.32, cy - r * 0.38
    gr = r * 0.42
    gd.ellipse([gx - gr, gy - gr * 0.7, gx + gr, gy + gr * 0.7], fill=(255, 255, 255, 120))
    gloss = gloss.filter(ImageFilter.GaussianBlur(r * 0.18))
    layer = Image.alpha_composite(layer, gloss)
    return layer


def make_icon():
    size = (S, S)
    canvas = Image.new("RGBA", size, (0, 0, 0, 0))

    # ---- White rounded-square card with a soft shadow beneath it ----
    def card_shape(d, color):
        d.rounded_rectangle([40, 40, S - 40, S - 40], radius=380, fill=color)

    card_shadow = soft_shadow_layer(size, card_shape, blur_radius=36, offset=(0, 18), alpha=55)
    canvas = Image.alpha_composite(canvas, card_shadow)
    card = Image.new("RGBA", size, (0, 0, 0, 0))
    ImageDraw.Draw(card).rounded_rectangle([0, 0, S, S], radius=380, fill=(255, 255, 255, 255))
    canvas = Image.alpha_composite(canvas, card)

    cx, cy = S * 0.44, S * 0.52
    rx, ry = S * 0.345, S * 0.300
    # The thumb-hole notch: a circle that bites into the right-middle edge of the
    # palette, turning the plain ellipse into a proper kidney/palette shape.
    notch_cx, notch_cy = cx + rx * 1.12, cy + ry * 0.18
    notch_r = ry * 0.38

    def palette_mask_img():
        m = Image.new("L", size, 0)
        md = ImageDraw.Draw(m)
        md.ellipse([cx - rx, cy - ry, cx + rx, cy + ry], fill=255)
        md.ellipse([notch_cx - notch_r, notch_cy - notch_r, notch_cx + notch_r, notch_cy + notch_r], fill=0)
        return m

    palette_mask = palette_mask_img()

    # ---- Soft shadow under the whole palette (kidney shape), for lift off the card ----
    shadow_layer = Image.new("RGBA", size, (0, 0, 0, 0))
    shadow_solid = Image.new("RGBA", size, (0, 0, 0, 80))
    shadow_layer.paste(shadow_solid, (0, 18), palette_mask)
    shadow_layer = shadow_layer.filter(ImageFilter.GaussianBlur(26))
    canvas = Image.alpha_composite(canvas, shadow_layer)

    # ---- Palette body: smooth vertical gradient, bright orange-yellow, kidney-shaped ----
    grad = Image.new("RGBA", size, (0, 0, 0, 0))
    gd = ImageDraw.Draw(grad)
    top_color, bottom_color = (255, 190, 60), (246, 148, 20)
    h = int(ry * 2)
    for i in range(h):
        t = i / max(h - 1, 1)
        r = int(top_color[0] + (bottom_color[0] - top_color[0]) * t)
        g = int(top_color[1] + (bottom_color[1] - top_color[1]) * t)
        b = int(top_color[2] + (bottom_color[2] - top_color[2]) * t)
        y = cy - ry + i
        gd.line([(cx - rx, y), (cx + rx, y)], fill=(r, g, b, 255))
    palette = Image.new("RGBA", size, (0, 0, 0, 0))
    palette.paste(grad, (0, 0), palette_mask)
    canvas = Image.alpha_composite(canvas, palette)

    # A soft inner highlight near the top of the palette, like light hitting matte paint
    hl = Image.new("RGBA", size, (0, 0, 0, 0))
    hld = ImageDraw.Draw(hl)
    hl_cx, hl_cy = cx - rx * 0.1, cy - ry * 0.55
    hld.ellipse([hl_cx - rx * 0.55, hl_cy - ry * 0.28, hl_cx + rx * 0.55, hl_cy + ry * 0.28],
                fill=(255, 255, 255, 50))
    hl = hl.filter(ImageFilter.GaussianBlur(rx * 0.12))
    hl_masked = Image.new("RGBA", size, (0, 0, 0, 0))
    hl_masked.paste(hl, (0, 0), palette_mask)
    canvas = Image.alpha_composite(canvas, hl_masked)

    # Subtle edge outline so the notch reads clearly, matching the reference's soft outline.
    # The ellipse's own stroke is clipped to exclude the bit inside the notch (since that
    # part of the boundary is "eaten away"), and the notch's stroke is clipped to only the
    # arc that actually crosses into the ellipse.
    from PIL import ImageChops
    outline_color = (210, 130, 20, 255)

    ellipse_outline = Image.new("RGBA", size, (0, 0, 0, 0))
    ImageDraw.Draw(ellipse_outline).ellipse(
        [cx - rx, cy - ry, cx + rx, cy + ry], outline=outline_color, width=7)
    notch_filled_mask = Image.new("L", size, 0)
    ImageDraw.Draw(notch_filled_mask).ellipse(
        [notch_cx - notch_r, notch_cy - notch_r, notch_cx + notch_r, notch_cy + notch_r], fill=255)
    notch_inverted = ImageChops.invert(notch_filled_mask)
    stroke_alpha = ellipse_outline.getchannel("A")
    ellipse_outline.putalpha(ImageChops.multiply(stroke_alpha, notch_inverted))

    notch_outline = Image.new("RGBA", size, (0, 0, 0, 0))
    ImageDraw.Draw(notch_outline).ellipse(
        [notch_cx - notch_r, notch_cy - notch_r, notch_cx + notch_r, notch_cy + notch_r],
        outline=outline_color, width=7)
    ellipse_filled_mask = Image.new("L", size, 0)
    ImageDraw.Draw(ellipse_filled_mask).ellipse([cx - rx, cy - ry, cx + rx, cy + ry], fill=255)
    notch_stroke_alpha = notch_outline.getchannel("A")
    notch_outline.putalpha(ImageChops.multiply(notch_stroke_alpha, ellipse_filled_mask))

    # Lower overall opacity for a subtle line rather than a hard dark edge
    for layer in (ellipse_outline, notch_outline):
        a = layer.getchannel("A").point(lambda v: int(v * 0.45))
        layer.putalpha(a)

    canvas = Image.alpha_composite(canvas, ellipse_outline)
    canvas = Image.alpha_composite(canvas, notch_outline)

    # ---- Paint dabs, each with its own soft shadow + gloss ----
    dabs = [
        (-0.30, -0.52, 0.185, (231, 76, 60)),   # red, upper
        (-0.62, 0.00, 0.185, (41, 128, 220)),   # blue, left
        (-0.30, 0.56, 0.185, (46, 170, 110)),   # green, lower-left
        (0.07, 0.68, 0.185, (155, 81, 224)),    # purple, bottom
    ]
    for ox, oy, r_frac, color in dabs:
        px, py = cx + ox * rx, cy + oy * ry
        r = rx * r_frac

        def dab_shape(d, c, px=px, py=py, r=r):
            d.ellipse([px - r, py - r, px + r, py + r], fill=c)
        shadow = soft_shadow_layer(size, dab_shape, blur_radius=14, offset=(0, 10), alpha=70)
        canvas = Image.alpha_composite(canvas, shadow)
        dab = glossy_dab(size, px, py, r, color)
        canvas = Image.alpha_composite(canvas, dab)

    # ---- Paintbrush: shaded cylindrical handle + metal ferrule + tapered blue tip ----
    brush_angle = -40
    handle_len = S * 0.50
    handle_w = S * 0.052
    handle_cx, handle_cy = S * 0.635, S * 0.375

    # Brush shadow (drawn as a rough silhouette of handle + tip)
    def brush_silhouette(d, color):
        pts = rotated_rect(handle_cx, handle_cy, handle_len * 0.60, handle_w, brush_angle)
        d.polygon(pts, fill=color)
        fcx = handle_cx + math.cos(math.radians(brush_angle)) * (handle_len * 0.34)
        fcy = handle_cy + math.sin(math.radians(brush_angle)) * (handle_len * 0.34)
        fpts = rotated_rect(fcx, fcy, handle_len * 0.11, handle_w * 1.3, brush_angle)
        d.polygon(fpts, fill=color)
        tbx = fcx + math.cos(math.radians(brush_angle)) * (handle_len * 0.09)
        tby = fcy + math.sin(math.radians(brush_angle)) * (handle_len * 0.09)
        tl = handle_len * 0.30
        a = math.radians(brush_angle)
        perp = math.radians(brush_angle + 90)
        bw = handle_w * 1.35
        tw = handle_w * 0.12
        b1 = (tbx + math.cos(perp) * bw / 2, tby + math.sin(perp) * bw / 2)
        b2 = (tbx - math.cos(perp) * bw / 2, tby - math.sin(perp) * bw / 2)
        tcx, tcy = tbx + math.cos(a) * tl, tby + math.sin(a) * tl
        t1 = (tcx + math.cos(perp) * tw / 2, tcy + math.sin(perp) * tw / 2)
        t2 = (tcx - math.cos(perp) * tw / 2, tcy - math.sin(perp) * tw / 2)
        d.polygon([b1, b2, t2, t1], fill=color)

    brush_shadow = soft_shadow_layer(size, brush_silhouette, blur_radius=16, offset=(6, 14), alpha=65)
    canvas = Image.alpha_composite(canvas, brush_shadow)

    layer = Image.new("RGBA", size, (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)

    # Handle with a light-to-dark gradient across its width for a rounded, cylindrical feel
    a = math.radians(brush_angle)
    perp = math.radians(brush_angle + 90)
    steps = 24
    for i in range(steps):
        t = i / (steps - 1)
        off = (t - 0.5) * handle_w
        shade = 1.0 - abs(t - 0.5) * 0.9
        base = (150, 102, 58)
        col = tuple(int(c * (0.65 + 0.5 * shade)) for c in base)
        x0 = handle_cx + math.cos(perp) * off - math.cos(a) * (handle_len * 0.30)
        y0 = handle_cy + math.sin(perp) * off - math.sin(a) * (handle_len * 0.30)
        x1 = handle_cx + math.cos(perp) * off + math.cos(a) * (handle_len * 0.30)
        y1 = handle_cy + math.sin(perp) * off + math.sin(a) * (handle_len * 0.30)
        d.line([(x0, y0), (x1, y1)], fill=col + (255,), width=3)

    # Metal ferrule with highlight stripe
    fcx = handle_cx + math.cos(math.radians(brush_angle)) * (handle_len * 0.34)
    fcy = handle_cy + math.sin(math.radians(brush_angle)) * (handle_len * 0.34)
    fpts = rotated_rect(fcx, fcy, handle_len * 0.11, handle_w * 1.3, brush_angle)
    d.polygon(fpts, fill=(214, 217, 222, 255))
    hi_pts = rotated_rect(fcx - math.cos(perp) * handle_w * 0.25,
                           fcy - math.sin(perp) * handle_w * 0.25,
                           handle_len * 0.11, handle_w * 0.28, brush_angle)
    d.polygon(hi_pts, fill=(245, 247, 250, 255))

    # Bristle tip: soft and rounded (flared, with a rounded cap), not a sharp point —
    # matching the reference's gentle brush tip rather than a dart-like triangle.
    tbx = fcx + math.cos(math.radians(brush_angle)) * (handle_len * 0.09)
    tby = fcy + math.sin(math.radians(brush_angle)) * (handle_len * 0.09)
    tl = handle_len * 0.26
    bw = handle_w * 1.4
    tw = handle_w * 0.75
    b1 = (tbx + math.cos(perp) * bw / 2, tby + math.sin(perp) * bw / 2)
    b2 = (tbx - math.cos(perp) * bw / 2, tby - math.sin(perp) * bw / 2)
    tcx, tcy = tbx + math.cos(a) * tl, tby + math.sin(a) * tl
    t1 = (tcx + math.cos(perp) * tw / 2, tcy + math.sin(perp) * tw / 2)
    t2 = (tcx - math.cos(perp) * tw / 2, tcy - math.sin(perp) * tw / 2)
    d.polygon([b1, b2, t2, t1], fill=(36, 120, 215, 255))
    # Rounded cap at the very tip so it ends softly instead of in a sharp corner
    d.ellipse([tcx - tw / 2, tcy - tw / 2, tcx + tw / 2, tcy + tw / 2], fill=(36, 120, 215, 255))
    # Lighter two-tone highlight along the upper edge for a bit of roundness
    mid = (tbx + tcx) / 2 + math.cos(perp) * bw * 0.10, (tby + tcy) / 2 + math.sin(perp) * bw * 0.10
    hi_tip = (tcx + math.cos(perp) * tw * 0.15, tcy + math.sin(perp) * tw * 0.15)
    d.polygon([b1, mid, hi_tip], fill=(100, 175, 242, 255))

    canvas = Image.alpha_composite(canvas, layer)

    # ---- Rainbow drip: flows from just below the brush tip, matching the reference ----
    drip_layer = Image.new("RGBA", size, (0, 0, 0, 0))
    dd = ImageDraw.Draw(drip_layer)
    drip_cx = tbx - handle_w * 0.1
    drip_cy = tby + S * 0.195
    rainbow = [(231, 76, 60), (255, 170, 40), (250, 210, 40), (60, 175, 110), (41, 128, 220)]
    band_w = S * 0.020
    for i, color in enumerate(rainbow):
        rr = S * 0.128 - i * band_w * 1.05
        bbox = [drip_cx - rr, drip_cy - rr * 0.5, drip_cx + rr, drip_cy + rr]
        dd.arc(bbox, 100, 190, fill=color + (255,), width=int(band_w))
    drip_layer = drip_layer.filter(ImageFilter.GaussianBlur(S * 0.0015))
    canvas = Image.alpha_composite(canvas, drip_layer)

    return canvas


def save_all(img):
    densities = {
        "mipmap-mdpi": 108,
        "mipmap-hdpi": 162,
        "mipmap-xhdpi": 216,
        "mipmap-xxhdpi": 324,
        "mipmap-xxxhdpi": 432,
    }
    base = "/home/claude/PrivateDrawingApp/app/src/main/res"
    for folder, size in densities.items():
        resized = img.resize((size, size), Image.LANCZOS)
        out_dir = os.path.join(base, folder)
        os.makedirs(out_dir, exist_ok=True)
        resized.save(os.path.join(out_dir, "ic_launcher.png"))

        mask = Image.new("L", (size, size), 0)
        ImageDraw.Draw(mask).ellipse([0, 0, size, size], fill=255)
        round_img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
        round_img.paste(resized, (0, 0), mask)
        round_img.save(os.path.join(out_dir, "ic_launcher_round.png"))


if __name__ == "__main__":
    icon = make_icon()
    save_all(icon)
    icon.resize((512, 512), Image.LANCZOS).save("/home/claude/icon_preview2.png")
    # Also render on a neutral gray backdrop so the white card edge is visible
    backdrop = Image.new("RGBA", (600, 600), (210, 213, 219, 255))
    small = icon.resize((512, 512), Image.LANCZOS)
    backdrop.alpha_composite(small, (44, 44))
    backdrop.save("/home/claude/icon_preview2_backdrop.png")
    print("Done")
